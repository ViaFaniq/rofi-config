configuration {
    show-icons: false;
    font: "JetBrainsMono Nerd Font 10";
    sorting-method: "fzf";
}

* {
    background:          #101824;
    background-alt:      #162030;
    surface:             #213247;
    foreground:          #dbe6f5;
    muted:               #627a9c;
    accent:              #3878c2;
    accent-strong:       #e0a23a;

    background-color:    transparent;
    text-color:          @foreground;
    border-color:        @surface;
    spacing:             0;
}

window {
    width:               440px;
    location:            center;
    anchor:              center;
    border:              2px;
    border-color:        @accent;
    border-radius:       8px;
    background-color:    @background;
    padding:             4px;
}

mainbox {
    children:            [ inputbar, listview ];
    padding:             14px;
    spacing:             12px;
    background-color:    @background;
}

inputbar {
    children:            [ prompt ];
    padding:             12px 16px;
    background-color:    @background-alt;
    border-radius:       6px;
}

prompt {
    text-color:          @accent;
    font:                "JetBrainsMono Nerd Font Bold 10";
}

listview {
    lines:               5;
    columns:             1;
    spacing:             6px;
    scrollbar:           false;
    fixed-height:        true;
    border:              0px;
    background-color:    transparent;
}

element {
    padding:             10px 14px;
    background-color:    transparent;
    text-color:          @foreground;
    border-radius:       6px;
}

element-text {
    vertical-align:      0.5;
    background-color:    transparent;
    text-color:          inherit;
}

element selected.normal {
    background-color:    @surface;
    text-color:          @accent-strong;
}

element normal.normal {
    background-color:    transparent;
    text-color:          @foreground;
}

element alternate.normal {
    background-color:    transparent;
    text-color:          @foreground;
}

element selected.active {
    background-color:    @surface;
    text-color:          @accent;
}

element selected.alternate {
    background-color:    @surface;
    text-color:          @accent-strong;
}

element selected.urgent {
    background-color:    @surface;
    text-color:          #cc3333;
}