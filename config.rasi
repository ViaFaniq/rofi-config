configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    font: "JetBrainsMono Nerd Font 10";
    terminal: "kitty";
}

* {
    /* Kolory dopasowane do Twojego motywu */
    background:          #101824;
    background-alt:      #162030;
    surface:             #213247;
    foreground:          #dbe6f5;
    muted:               #627a9c;
    accent:              #3878c2;
    accent-strong:       #e0a23a;

    background-color:    transparent;
    text-color:          @foreground;
    border-color:        @surface;
    spacing:             0;
}

window {
    width:               580px;
    location:            center;
    anchor:              center;
    border:              2px;
    border-color:        @accent;
    border-radius:       8px;
    background-color:    @background;
    padding:             4px;
}

mainbox {
    children:            [ inputbar, listview ];
    padding:             14px;
    spacing:             12px;
    background-color:    @background;
}

inputbar {
    children:            [ prompt, entry ];
    padding:             12px 16px;
    spacing:             12px;
    background-color:    @background-alt;
    border-radius:       6px;
}

prompt {
    text-color:          @accent;
    font:                "JetBrainsMono Nerd Font Bold 10";
}

entry {
    placeholder:         "Search applications...";
    placeholder-color:   @muted;
    text-color:          @foreground;
    cursor:              text;
}

listview {
    lines:               6;
    columns:             1;
    spacing:             6px;
    scrollbar:           false;
    fixed-height:        false;
    border:              0px;
    background-color:    transparent;
}

element {
    children:            [ element-icon, element-text ];
    padding:             10px 14px;
    spacing:             14px;
    background-color:    transparent;
    text-color:          @foreground;
    border-radius:       6px;
}

element-icon {
    size:                24px;
    background-color:    transparent;
}

element-text {
    vertical-align:      0.5;
    background-color:    transparent;
    text-color:          inherit;
}

element selected.normal {
    background-color:    @surface;
    text-color:          @accent-strong;
}

element normal.normal {
    background-color:    transparent;
    text-color:          @foreground;
}

element alternate.normal {
    background-color:    transparent;
    text-color:          @foreground;
}

element selected.active {
    background-color:    @surface;
    text-color:          @accent;
}

element selected.alternate {
    background-color:    @surface;
    text-color:          @accent-strong;
}

element selected.urgent {
    background-color:    @surface;
    text-color:          #cc3333;
}